# Demo mode needs no Discord credentials and never contacts Discord.
DEMO_MODE=true
HOST=127.0.0.1
PORT=3000
DATA_DIR=.data
# For a real server, set DEMO_MODE=false and add these values locally.
DISCORD_TOKEN=
# Default server and authentication database. Invite this bot to additional servers
# to show them in the owner dashboard; keep this ID unchanged to preserve keys.
DISCORD_GUILD_ID=
# Set to your external HTTPS origin behind a trusted reverse proxy in production.
PUBLIC_ORIGIN=http://localhost:3000
# Number of trusted proxy hops. Leave 0 for direct/local access.
TRUST_PROXY=0
